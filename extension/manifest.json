{
  "manifest_version": 3,
  "name": "QuickVault — Instant Copy Vault",
  "description": "1-tap copy recurring links, handles, portfolio, emails, and snippets without leaving your active tab.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickVault — Instant Copy Vault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
